# Django API backend URL
DJANGO_API_URL=http://localhost:8000

# Public Django URL (for OAuth redirects from the browser)
NEXT_PUBLIC_DJANGO_URL=http://localhost:8000

# iron-session encryption secret (must be >= 32 chars)
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# OAuth2 client credentials (from django-oauth-toolkit Application)
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# Set to "true" to bypass auth in local development
NEXT_PUBLIC_AUTH_BYPASS=true
